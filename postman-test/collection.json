              "//Validate Response body\r",
              "pm.test(\"Validate response body for request to get repo with invalid token\", function () {\r",
              "    pm.expect(pm.response.json().message).to.eql(\"Not Found\");\r",
              "    pm.expect(pm.response.json().status).to.eql(\"404\");\r",
              "});\r",
