{
    "createRepo":{
        "requestType":"POST",
        "endpoint":"/user/repos",
        "body":{
            "name":"tbu",
            "description":"A framework for testing with Playwright and TDD approach",
            "private":false
        },
        "expectedCode":422,
        "expectedStatusMessage":"Unprocessable Entity",
        "expectedErrorMessage":"Repository creation failed."
    },
    "updateRepo":{
        "requestType":"PATCH",
        "endpoint":"/repos/{owner}/{repo}",
        "body":{
            "name":"PlaywrightRepo",
            "description":"Updated description for the repository",
            "private":false
        },
        "expectedCode":200,
        "expectedStatusMessage":"OK",
        "expectedRepoName":"PlaywrightRepo"
    }
}